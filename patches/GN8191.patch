+                    meanBenchmarker += benchmarker;
+                    secretKey.Decrypt(poly2, c1);
+                    for (long i = 0; i < context.getPhiM(); i++)
+                    {
+                        if (ptxt_poly1[i] != poly2[i])
+                            std::cout << i << " is bad\n"<<"ptxt_poly1["<<i<<"] = " << ptxt_poly1[i] <<"poly2["<<i<<"] = "<<poly2[i]<<std::endl;
