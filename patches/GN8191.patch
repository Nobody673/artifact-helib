+  // for(long i = 0; i < n_slots; i++) {
+  //   auto it = std::find(pwfl_s2c.begin(), pwfl_s2c.end(), NTL::ZZ(i+1));
+  //   if(it != pwfl_s2c.end())
+  //     printf("%ld found at %ld\n", i+1, it - pwfl_s2c.begin());
+  // }
+  // XXX: end debug
+#endif
+
