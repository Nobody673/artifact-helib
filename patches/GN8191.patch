+        if (!noPrint)//这里应该是打印的比特提取的空间
+        {
+            std::cout << " done in " << time << " seconds" << std::endl;
+            std::cout << "  e=" << context.getRcData().e
+                      << ", e'=" << context.getRcData().ePrime
+                      << ", t=" << context.getRcData().skHwt << "\n"
+                      << "  ";
