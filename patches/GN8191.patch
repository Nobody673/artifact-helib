+    GTestFatboot(Parameters param, //以数据结构Parameters的一个对象param作为输入
+                 bool noPrint,
+                 bool dry,
+                 long encapSkHwt,
+                 long btsC,
+                 long t,
+                 long btsScale,
+                 long newBtsFlag,
+                 bool newKSFlag,
