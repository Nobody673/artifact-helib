+std::vector<NTL::ZZX> loadPlaintextFromFile(const std::string& filename, const Context& context)
+{ 
+
+  const helib::EncryptedArray& ea = context.getEA();
+  long nslots = ea.size();
+
+  std::ifstream infile(filename);
+  if (!infile)
+    throw std::runtime_error("无法打开文件: " + filename);
+
+  std::vector<NTL::ZZX> slot_values(nslots);
+  std::string line;
+  std::regex line_pattern(R"(槽\s*(\d+):\s*(.*))");
+  std::regex term_pattern(R"((\d+)(?:\*x(?:\^(\d+))?)?)");
+  std::smatch match;
+
+  while (std::getline(infile, line)) {
+  if (std::regex_match(line, match, line_pattern)) {
+    long slot_index = std::stol(match[1].str());
+    std::string poly_str = match[2].str();
+    if (slot_index >= nslots) continue;
+
+    NTL::ZZX poly;
+    auto it = std::sregex_iterator(poly_str.begin(), poly_str.end(), term_pattern);
+    for (; it != std::sregex_iterator(); ++it) {
+
+      // 关键：用 ZZ 解析系数，避免 32-bit 溢出
+      NTL::ZZ coeff = NTL::to_ZZ((*it)[1].str().c_str());
+
+      long deg = 0;
+      if ((*it)[2].matched)
+        deg = std::stol((*it)[2].str());
+      else if ((*it).str().find("*x") != std::string::npos)
+        deg = 1;
+
+      NTL::SetCoeff(poly, deg, coeff);
+    }
+
+    slot_values[slot_index] = poly;
+  }
+}
+
+  return slot_values;
+}
+
+void saveSlotPolynomialsToFile(const std::vector<NTL::ZZX>& polys, const std::string& filename) {
+    std::cout << "开始写入文件" << std::endl;
+    std::ofstream out(filename);
+    if (!out.is_open()) {
+        std::cerr << "无法打开文件 " << filename << " 进行写入" << std::endl;
+        return;
+    }
+
+    out << "槽多项式总数: " << polys.size() << "\n";
+    for (size_t i = 0; i < polys.size(); ++i) {
+        out << "槽 " << i << ": " << polys[i] << "\n";
+    }
+
+    out.close();
+    std::cout << "已写入文件" << std::endl;
+}
