+void NormpolyEval(const NTL::ZZX& s1,const NTL::ZZX& s2,const NTL::ZZX& s3,const NTL::ZZX& s4,const NTL::ZZX& s5,const NTL::ZZX& s6,
+                         const NTL::ZZX& a0,const NTL::ZZX& a1,const NTL::ZZX& a2,const NTL::ZZX& a3,const NTL::ZZX& a4,const NTL::ZZX& a5,const NTL::ZZX& a6,const NTL::ZZX& a7,const NTL::ZZX& a8,const NTL::ZZX& a9,
+                         const NTL::ZZX& g0,const NTL::ZZX& g1,const NTL::ZZX& g2,
+                  std::vector<helib::Ctxt*>& ret,
+                   const helib::Ctxt& x,
+                   const helib::Context& context
+                  // ,const helib::SecKey& secretKey, const helib::Context& context_r2
+                   
+                  )
+{{ 
+  // 1. 复制输入密文、明文
+
+  helib::Ctxt ctxtx = x; 
+
+  //x^2
+  helib::Ctxt xSquared = x;
+  xSquared.multiplyBy(xSquared);
+
+  //x^3
+  helib::Ctxt x3 = x;
+  x3.multiplyBy(xSquared);
+
+
+  // 2.构造term
+  helib::Ctxt term13 = x3;       // 创建一个新的 Ctxt，初始化为 term1
+  helib::Ctxt term12 = xSquared;
+  helib::Ctxt term11 = x;
+  term12.multByConstant(s1);//s1x^2
+  term11.multByConstant(s2);//-s2x
+
+  term13 += term12;
+  term13 += term11;
+  term13.addConstant(s3);//-x3+s1x2-s2x+s3
+
+  helib::Ctxt term22 = xSquared;
+  helib::Ctxt term21 = x;
+  term22.multByConstant(s4);//-s4x2
+  term21.multByConstant(s5);//s5x
+  term22 += term21;
+  term22.addConstant(s6);
+
+  term13.multiplyBy(x3);
+  term13 += term22;
+
+
+  // 3.计算a(X)
+
+  helib::Ctxt f3 = x;     // 创建一个新的 Ctxt，初始化为 term1
+
+  helib::Ctxt f23 = x3;
+  helib::Ctxt f22 = xSquared;
+  helib::Ctxt f21 = x;
+  f23.multByConstant(a9);
+  f22.multByConstant(a8);
+  f21.multByConstant(a7);
+  f23 += f22;
+  f23 += f21;
+  f23.addConstant(a6);
+
+  helib::Ctxt f12 = xSquared; 
+  helib::Ctxt f11 = x; 
+  f12.multByConstant(a5);
+  f11.multByConstant(a4);
+  f12 += f11;
+  f12.addConstant(a3);  
+
+  helib::Ctxt f02 = xSquared; 
+  helib::Ctxt f01= x; 
+  f02.multByConstant(a2);
+  f01.multByConstant(a1);
+  f02 += f01;
+  f02.addConstant(a0);
+
+
+  f3.multiplyBy(x3);//x^4
+  f3 += f23;//x4+a9x3+a8x2+a7x+a6
+  f3.multiplyBy(x3);
+  f3 += f12;//x^7...
+  f3.multiplyBy(x3);
+  f3 += f02;
+
+
+  // 4.进行norm计算
+  
+  auto [phi3, phi6] = helib::hoistedFrobenius2(term13, 3, 6, context);
+  term13.multiplyBy(phi3);
+
+  auto [phi1, phi2] = helib::hoistedFrobenius2(term13, 1, 2, context);
+  term13.multiplyBy2(phi1,phi2);
+
+  term13.multiplyBy(phi6);
+
+  helib::Ctxt temp0 = term13;
+  applyFrobenius(temp0, 7, context);
+  term13.multiplyBy(temp0);
+
+  //5.把a乘上，把g剪掉
+
+  term13.multiplyBy(f3);
+  term13.negate();
+
+  helib::Ctxt result = term13;
+  
+  //result.addConstant(constant1);//c-4
+  result.addConstant(g0);//
+
+  ctxtx.multByConstant(g1);//1222x
+  result += ctxtx ;//
+
+  xSquared.multByConstant(g2);
+  result += xSquared ;//
+
+
+
+  *ret[0] = result;
+
+}
