+void applyFrobenius(helib::Ctxt& ctxt, long i, const helib::Context& context)
+{
+  long p = context.getP();  // 明文模数
+  long m = context.getM();  // 多项式模数
+  long k = NTL::PowerMod(p, i, m); // 计算 k = p^i mod m
+  ctxt.smartAutomorph(k); // 应用 x -> x^k 的 automorphism
+}
