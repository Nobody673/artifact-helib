+  result.addConstant(g0);//x+g0
+
+  //ctxtx *= 12L;
+  result -= ctxtx ;
+
+  xSquared *= 15L;
+  result -= xSquared;
+
+  x4 *= 8L;
+  result -= x4;
+
+  x8 *= 7L;
+  result -= x8;
+ 
+  x16 *= 3L;
+  result -= x16;
+  
+  *ret[0] = result;
+
+}
