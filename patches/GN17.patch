+// inputs are always relined, outputs are not
+long cost_n_leaves(long n) {//没看懂这个算法在算什么，密文乘的个数吗？
+  long cost = 0;
+  if(n <= 2)
+    return 0;  
+  long prevPo2 = NTL::NextPowerOfTwo(n);
+  if(1L << prevPo2 > n)//除非n是2的幂，否则一定成立
+    prevPo2 -= 1;
+  prevPo2 = 1 << prevPo2;//卡在n/2到n之间的2的幂
+  // a subtree of size 2^k has a cost of 2^(k-1)-2
+  if(prevPo2 == n)//n是2的幂的情况
+    return prevPo2 / 2 - 1;
+  // 1 = relin the one the inputs
+  cost += 1 + cost_n_leaves(n - prevPo2) + prevPo2 / 2 - 1;
+  return cost;
+}
