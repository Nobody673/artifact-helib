+// 通用 hoist：传入多个 k，返回对应 automorphism 结果
+std::vector<Ctxt> hoistedAutomorphs(const Ctxt& ctxt,
+                                    const std::vector<long>& ks)
+{
+  std::vector<Ctxt> outs;
+  outs.reserve(ks.size());
+
+  // 利用 BasicAutomorphPrecon 做一次分解（hoist）
+  BasicAutomorphPrecon precon(ctxt);
+
+  for (long k : ks) {
+    // precon.automorph(k) 返回 shared_ptr<Ctxt>
+    std::shared_ptr<Ctxt> ptr = precon.automorph(k);
+    outs.emplace_back(*ptr); // 拷贝到返回数组（可改成移动/就地构造）
+  }
+  return outs;
+}
+
+// Frobenius：把 i 转换成 k = p^i mod m，再复用上面的通用接口
+std::vector<Ctxt> hoistedFrobenius(const Ctxt& ctxt,
+                                   const std::vector<long>& exponents,
+                                   const Context& context)
+{
+  const long p = context.getP();
+  const long m = context.getM();
+
+  std::vector<long> ks;
+  ks.reserve(exponents.size());
+  for (long i : exponents) {
+    ks.push_back(NTL::PowerMod(p, i, m));
+  }
+  return hoistedAutomorphs(ctxt, ks);
+}
+
+// 常用两次 Frobenius 的便捷封装
+std::pair<Ctxt, Ctxt> hoistedFrobenius2(const Ctxt& ctxt,
+                                        long i1, long i2,
+                                        const Context& context)
+{
+  auto outs = hoistedFrobenius(ctxt, std::vector<long>{i1, i2}, context);
+  // 假定 outs.size() == 2
+  return {std::move(outs[0]), std::move(outs[1])};
+}
