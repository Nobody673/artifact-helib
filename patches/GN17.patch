+                  std::vector<helib::Ctxt*>& ret,
+                   const helib::Ctxt& x,
+                   const helib::Context& context
+                   //,const helib::SecKey& secretKey, const helib::Context& context_r2
+                   
+                  )
+{ std::cout<<"Using NormpolyEval"<<std::endl;
+  // 1. 复制输入密文、明文
+
+
+  helib::Ctxt ctxtx = x; 
+
+
+  helib::Ctxt xSquared = x;
+  xSquared.multiplyBy(xSquared);
+
+
+  //x^3
+  helib::Ctxt x3 = x;
+  x3.multiplyBy(xSquared);
+
+  //x^4
+  helib::Ctxt x4 = xSquared;
+  x4.multiplyBy(x4);
+
+  helib::Ctxt x8 = x4;
+  x8.multiplyBy(x4);
+
+  //x^16
+  helib::Ctxt x16 = x4;
+  x16.multiplyBy(x16);
+  x16.multiplyBy(x16);
+
+
+  //用lifting算一个结果出来
+
+
+  helib::Ctxt gaint = x;
+
+  helib::Ctxt baby3 = x3;
+  helib::Ctxt baby2 = x3;
+  helib::Ctxt baby1 = x3;
+  helib::Ctxt baby0 = x3;
+
+  helib::Ctxt baby31 = x;
+  helib::Ctxt baby21 = x;
+  helib::Ctxt baby11 = x;
+  helib::Ctxt baby01 = x;
+
+  baby3 *= 85L;
+  baby2 *= 136L;
+  baby1 *= 34L;
+  baby0 *= 255L;
+
+  baby31 *= 238L;
+  baby21 *= 153L;
+  baby11 *= 17L;
+  baby01 *= 153L;
+
+  baby3 += baby31;
+  baby2 += baby21;
+  baby1 += baby11;
+  baby0 += baby01;
+
+  gaint *= 86L;
+  gaint *= x16;
+
+  baby1 *= x4;
+  baby3 *= x4;
+  baby1 += baby0;
+  baby3 += baby2;
+  baby3 *= x8;
+  gaint += baby3;
+  gaint += baby1;
+
+  *ret[1] = gaint;
+
+  // 2.构造term
+  helib::Ctxt term = x4;       // 创建一个新的 Ctxt，初始化为 term1
+  helib::Ctxt term3 = x3;
+  helib::Ctxt term2 = xSquared;
+  helib::Ctxt term1 = x;
+
+  term3.multByConstant(s1);
+  term2.multByConstant(s2);
+  term1.multByConstant(s3);
+  term.addCtxt(term3);
+  term.addCtxt(term2);
+  term.addCtxt(term1);
+  term.addConstant(s4);
+
+  // 3.进行norm计算
+
+
+  auto [phi1, phi2] = helib::hoistedFrobenius2(term, 1, 2, context);
+  term.multiplyBy2(phi1,phi2);
+
+  helib::Ctxt temp0 = term;
+  applyFrobenius(temp0, 3, context);//pai^3((I*pai)(a))
+  term.multiplyBy(temp0);
+
+  temp0 = term;
+  applyFrobenius(temp0, 6, context);
+  term.multiplyBy(temp0);
+
+  temp0 = term;
+  applyFrobenius(temp0, 12, context);
+  term.multiplyBy(temp0);
+
+
+
+//以下是计算最后的结果
+
+  helib::Ctxt result = term; 
+
+
+  result.addConstant(g0);//x+g0
+
+  //ctxtx *= 12L;
+  result -= ctxtx ;
+
+  xSquared *= 15L;
+  result -= xSquared;
+
+  x4 *= 8L;
+  result -= x4;
+
+  x8 *= 7L;
+  result -= x8;
+ 
+  x16 *= 3L;
+  result -= x16;
+  
+  *ret[0] = result;
+
+}
