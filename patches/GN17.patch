+    mod_qKS.setPrimes(IndexSet(context.getIndexQks()));
+    mod_R.setPrimes(IndexSet(context.getIndexR()));
+    p2d_conv.dcrtToPowerful(pwrfl_qKS, mod_qKS);
+    p2d_conv.dcrtToPowerful(pwrfl_R, mod_R);
+
+    // vecRed(pwrfl, pwrfl, Q, false);
