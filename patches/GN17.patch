+    // FIXME: it looks like the coefficients should already be reduced
+
+    // add -[a]_R*P*[P^-1]_R = -P*[a*P^-1]_R to the element modulo qKS
+    // the mult it by [R^-1]_qKS
+    NTL::ZZ pInvR = NTL::InvMod(NTL::ZZ(p2r), R);
