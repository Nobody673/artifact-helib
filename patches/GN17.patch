+// return min(i), s.t., p^e | ((n+i)*...*(n+1))
+static long truncated_smarandache(long n, long p, long e)
+{
+  // start from p*ceil((n+1)/p)
+  long i = p*(1+n/p);
+  long count = 0;
+  while (true) {
+    count += valuation(i, p);
+    if(count >= e)
