+  baby3 *= x8;
+  gaint += baby3;
+  gaint += baby1;
+
+  *ret[1] = gaint;
+
+  // 2.构造term
+  helib::Ctxt term = x4;       // 创建一个新的 Ctxt，初始化为 term1
