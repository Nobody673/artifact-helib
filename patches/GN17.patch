+    alpha *= double(m) / sqrt(double(phim));
+  R = ceil(alpha / beta);
+  printf("log2(R) >= %f", log(double(R)) / log(2.0));
+  // again, search for the next prime >= R with m-th root
+  tmp = R % m;
+  if (tmp <= 1)
+    R += 1 - tmp;
+  else
+    R += m + 1 - tmp;
+  while (!NTL::ProbPrime(R, 60))
+    R += m;
+  printf(", final log2(R) = %f\n", log(double(R)) / log(2.0));
+
+  return minCapacity;
