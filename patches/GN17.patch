+// return p-valuation of x
+static long valuation(long x, long p)
+{
+  long val = 0;
+  while (x % p == 0) {
+    val++;
+    x /= p;
+  }
+  return val;
+}
+
+// return p-valuation of factorial(n)
+static long valuationFactorial(long n, long p)
+{
+  long i = p;
+  long val = 0;
+  while (i <= n) {
+    val += valuation(i, p);
+    i += p;
+  }
+  return val;
+}
+
+// return min(i) s.t. p^e | factorial(i)
+// NOTE: seems unused...
