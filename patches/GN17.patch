+  applyFrobenius(temp0, 6, context);
+  term.multiplyBy(temp0);
+
+  temp0 = term;
+  applyFrobenius(temp0, 12, context);
+  term.multiplyBy(temp0);
+
+
+
+//以下是计算最后的结果
+
+  helib::Ctxt result = term; 
+
