+void NormpolyEval(const NTL::ZZX& s1,const NTL::ZZX& s2,const NTL::ZZX& s3,const NTL::ZZX& s4,const NTL::ZZX& s5,
+                         const NTL::ZZX& a0,const NTL::ZZX& a1,const NTL::ZZX& a2,const NTL::ZZX& a3,
+                         const NTL::ZZX& g0,const NTL::ZZX& g1,
+                  std::vector<helib::Ctxt*>& ret,
+                   const helib::Ctxt& x,
+                   const helib::Context& context
+                   //,const helib::SecKey& secretKey, const helib::Context& context_r2
+                   
+                  )
+{ 
+  // 1. 复制输入密文、明文
+
+  helib::Ctxt ctxtx = x; 
+
+  //x^2
+  helib::Ctxt xSquared = x;
+  xSquared.multiplyBy(xSquared);
+
+  //x^3
+  helib::Ctxt x3 = x;
+  x3.multiplyBy(xSquared);
+
+  //x^4
+  helib::Ctxt x4 = xSquared;
+  x4.multiplyBy(x4);
+  //x^5
+  helib::Ctxt x5 = x4;
+  x5.multiplyBy(x);
+
+  // 2.构造term
+  helib::Ctxt term1 = x;       // 创建一个新的 Ctxt，初始化为 term1
+  helib::Ctxt term2 = xSquared;
+  helib::Ctxt term3 = x3;
+  helib::Ctxt term4 = x4;
+  helib::Ctxt term = x5;
+  term.negate(); //-x^5
+
+  term1.multByConstant(s4); //-s4x
+  term2.multByConstant(s3); //s3x^2
+  term3.multByConstant(s2); //-s2x^3
+  term4.multByConstant(s1); //s1x^4
+
+
+
+  
+  term += term1;//-x^5-s4x
+  term += term2;
+  term += term3;
+  term += term4;
+  term.addConstant(s5);
+
+
+  // 3.计算a(X)
+
+  helib::Ctxt a = x4;
+  helib::Ctxt aterm1 = x;       // 创建一个新的 Ctxt，初始化为 term1
+  helib::Ctxt aterm2 = xSquared;
+  helib::Ctxt aterm3 = x3; 
+  
+  aterm1.multByConstant(a1); //a1x
+  aterm2.multByConstant(a2); //a2x^2
+  aterm3.multByConstant(a3); //a3x^3
+  
+  a.addConstant(a0);
+  a += aterm1;
+  a += aterm2;
+  a += aterm3;
+
+
+  // 4.进行norm计算
+  
+
+  auto [phi1, phi2] = helib::hoistedFrobenius2(term, 1, 2, context);
+  term.multiplyBy2(phi1,phi2);
+
+
+
+  auto [phi3, phi6] = helib::hoistedFrobenius2(term, 3, 6, context);
+  term.multiplyBy2(phi3,phi6);
+
+
+  helib::Ctxt temp0 = term;
+  applyFrobenius(temp0, 9, context);//pai^3((I*pai)(a))
+  term.multiplyBy(temp0);
+
+
+ //以下是计算最后的结果
+
+  //5.把a乘上，把g剪掉
+
+  term.multiplyBy(a);
+  helib::Ctxt result = term;
+  
+  result.negate();
+
+
+
+  //result.addConstant(constant1);//c-4
+  result.addConstant(g0);//
+
+
+  ctxtx.multByConstant(g1);//1222x
+  result += ctxtx ;//
+
+  
+  *ret[0] = result;
+
+}
