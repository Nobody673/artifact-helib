diff --git a/CMakeLists.txt b/CMakeLists.txt
index 6a5de0a..3419ba1 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,3 +1,23 @@
+# Copy runtime data files next to the fatboot executable after build
+# --- Paper artifact executable ---
+add_executable(fatboot tools/fatboot.cpp)
+target_link_libraries(fatboot PRIVATE helib)
+target_include_directories(fatboot PRIVATE ${PROJECT_SOURCE_DIR}/include)
+# Choose which parameter set data to copy next to fatboot
+set(PARAM_SET "params65537" CACHE STRING "which data set to use (params1..params5)")
+set(FATBOOT_DATA_DIR "${CMAKE_SOURCE_DIR}/data/${PARAM_SET}")
+
+if(NOT EXISTS "${FATBOOT_DATA_DIR}")
+  message(FATAL_ERROR "Data directory not found: ${FATBOOT_DATA_DIR}")
+endif()
+
+add_custom_command(TARGET fatboot POST_BUILD
+    COMMAND ${CMAKE_COMMAND} -E copy_directory
+            "${FATBOOT_DATA_DIR}"
+            "$<TARGET_FILE_DIR:fatboot>"
+    COMMENT "Copying data/${PARAM_SET} next to fatboot"
+)
+
 # Copyright (C) 2019-2020 IBM Corp.
 #
 # This program is Licensed under the Apache License, Version 2.0
@@ -59,6 +79,7 @@ set(HELIB_PROJECT_ROOT_DIR "${PROJECT_SOURCE_DIR}")
 set(HELIB_CMAKE_EXTRA_DIR "${PROJECT_SOURCE_DIR}/cmake")
 # Prefix of the header files (directory to be added to the include list)
 set(HELIB_INCLUDE_DIR "${PROJECT_SOURCE_DIR}/include")
+include_directories(BEFORE ${HELIB_INCLUDE_DIR})
 # Location of helib header files
 set(HELIB_HEADER_DIR "${HELIB_INCLUDE_DIR}/helib")
 # Location of the source files
