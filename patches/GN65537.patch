+    void TearDown()//主要功能是清除和输出调试信息
+    {
+        if (noPrint)
+        {
+            helib::printAllTimers();
+        }
+        if (helib::fhe_stats)
+            helib::print_stats(std::cout);
+
+        cleanupBootstrappingGlobals();
+        helib::cleanupDebugGlobals();
+    }
