+      pwrfl_qKS[j] = NTL::SubMod(pwrfl_qKS[j], tmp, qKS);
+      pwrfl_qKS[j] = NTL::MulMod(pwrfl_qKS[j], RInvQks, qKS);
+    }
+    helib::vecRed(pwrfl_qKS, pwrfl_qKS, qKS, false);
